{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": { ".write": "auth != null && auth.uid === $uid" },
        "creditBalance": { ".write": false },
        "transactions": { ".write": false },
        "paymentRequests": { ".write": false },
        "groupHistory": { ".write": false }
      }
    },
    "topupRequests": { "$id": { ".read": "auth != null && (data.child('uid').val() === auth.uid || auth.token.admin === true)", ".write": false } },
    "utrIndex": { ".read": false, ".write": false },
    "catalog": { ".read": "auth != null", ".write": "auth != null && auth.token.admin === true" },
    "publicConfig": { ".read": true, ".write": "auth != null && auth.token.admin === true" }
  }
}
